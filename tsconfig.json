{
	"compilerOptions": {
	  "target": "ES2020",
	  "module": "ESNext",
	  "moduleResolution": "Bundler",
	  "strict": true,
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "declaration": true,
	  "declarationMap": true,
	  "outDir": "dist",
	  "verbatimModuleSyntax": true
	},
	"include": ["src", "examples", "scripts/check-types.ts"]
  }
  